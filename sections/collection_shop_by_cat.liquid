{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{{ 'custom-section.css' | asset_url | stylesheet_tag }}  

{%  if section.blocks.size > 0 %}
    <div class="shop-by-cat-section">
        {%  if section.settings.title != blank %}
            <h2 class="h1">{{ section.settings.title }}</h2>
        {%  endif  %}

    </div>
{%  endif %}  

{% schema %}
    {
      "name": "Tabs",
      "settings": [  
        {
          "type": "text", 
          "id": "title",
          "label": "Title"
        },
         {
          "type": "checkbox",
          "id": "useslider",
          "label": "Use slider",
          "default": true
        },
        {
          "type": "radio",
          "id": "tabType",
          "label": "Tab Type",
          "options": [
                {
                "value": "tabOnTop",
                "label": "Tab On Top"
                },
                {
                "value": "tabOnSide",
                "label": "Tab On Side"
                }
            ],
          "default": true
        },
        {
          "type": "checkbox",
          "id": "usesImageTabTitle",
          "label": "Uses Image Tab Title",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enViewAll",
          "label": "Enable View All",
          "default": true
        },
        {
          "type": "number",
          "id": "numOfItems",
          "label": "Number Of Items",
          "default": 20
        },  
        {
          "type": "range",
          "id": "marginBottom",
          "label": "Margin Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }, 
        {
          "type": "range",
          "id": "marginTop",
          "label": "Margin Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }  
      ],
      "blocks": [
      {
        "type": "tab",
        "name": "Tab",
        "limit": 15,
      
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "checkbox",
          "id": "viewall",
          "label": "Show view all",
          "default": true
        }
      ]
    
      }
    ],
      "presets": [
      {
        "name": "Tabs",
        "blocks": []
      }
    ]
    }
  {% endschema %} 